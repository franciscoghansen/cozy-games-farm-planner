{
  "name": "coral-island-farm-planner",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "test": "node --disable-warning=ExperimentalWarning --experimental-strip-types --test tests/*.test.ts",
    "start:local": "node scripts/start-local.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:coverage": "c8 npm test && node scripts/check-coverage.mjs",
    "test:e2e": "playwright test",
    "validate:data": "node --experimental-strip-types scripts/validate-data.ts",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run validate:data && npm run test:coverage",
    "lint:dead-code": "knip --no-exit-code"
  },
  "dependencies": {
    "lucide-react": "^0.577.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint-react/eslint-plugin": "^5.30.4",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "c8": "^12.0.0",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fake-indexeddb": "^6.2.8",
    "knip": "^6.45.1",
    "prettier": "^3.10.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^7.3.0"
  },
  "engines": {
    "node": ">=22.16.0 <23 || >=24.0.0"
  }
}
